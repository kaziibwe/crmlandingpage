[TEMPLATE]
# --- MongoDB (Administration Portal) ---
# MongoDB connection string. NEVER commit real credentials.
# Example: mongodb://user:pass@host:27017/?authSource=admin
MONGO_URI=

# Optional: database name (defaults to "eternitycrm_website")
MONGO_DB_NAME=

# Base URL of the running server (change between localhost and ngrok).
# Used by the test script and SSE config to build the full webhook URL.
BASE_URL=http://localhost:3000

# --- Auth ---
# Secret used to sign admin session cookies (HMAC). Use a long random string.
AUTH_SECRET=

# --- Default seed administrator (npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@eternitycrm.com
SEED_ADMIN_PASSWORD=password

# --- Intelli Partner webhook receiver ---
# Shared secret used to verify HMAC-SHA256 signatures on POST /api/webhooks/events.
# The receiver reads this from env (single shared secret), not from the DB.
# Use the same secret when signing payloads on the sender side.
# Example (generate once, keep secret): openssl rand -hex 32
INTELLI_WEBHOOK_SECRET=
